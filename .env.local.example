# Renommez ce fichier en .env.local et remplissez les valeurs.
# Le site fonctionne SANS ces variables en mode démo.

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Stripe (paiement réel) ----------
# Obtenez vos clés sur https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ---------- Admin (dashboard /admin) ----------
ADMIN_PASSWORD=changez-moi-en-un-mot-de-passe-fort
# Générer avec : openssl rand -base64 32
AUTH_SECRET=changez-moi-en-une-cle-aleatoire-de-32-caracteres-minimum
